{
  "name": "nexagram-desktop",
  "version": "1.1.0",
  "description": "Nexagram для ПК",
  "main": "main.js",
  "author": "Nexagram",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "site.nexagram.desktop",
    "productName": "Nexagram",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "pc.html",
      "icon.png",
      "package.json"
    ]
  }
}